{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "paths": { "graph-templates": ["./src/index.ts"] }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "templates/**/*.ts", "verify/**/*.ts"],
  "exclude": ["**/node_modules/**", "**/runs/**"]
}
